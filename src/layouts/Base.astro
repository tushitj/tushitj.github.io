---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogType?: "profile" | "article" | "website";
}

const SITE_NAME = "Tushit Jain";
const {
  title,
  description = "Engineering manager at Toast who still builds: teams, platforms, and a home lab.",
  ogType = "website",
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Engineering Manager`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/assets/img/og-profile.jpg", Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/#how", label: "How I work" },
  { href: "/#work", label: "Work" },
  { href: "/notes/", label: "Notes", current: path.startsWith("/notes") },
  { href: "/#lab", label: "Lab" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content={SITE_NAME} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link visually-hidden" href="#main">Skip to main content</a>
    <div class="page">
      <header class="site-header mono">
        <a href="/" aria-current={path === "/" ? "page" : undefined}>{SITE_NAME}</a>
        <nav aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.current ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="resume-link" href="/resume/" aria-current={path === "/resume" ? "page" : undefined}>Resume →</a>
      </header>

      <main id="main" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer mono">
        <ul>
          <li><a href="mailto:tushitjain@gmail.com">Email</a></li>
          <li><a href="https://www.linkedin.com/in/jaintushit/" rel="me">LinkedIn</a></li>
          <li><a href="https://github.com/tushitj" rel="me">GitHub</a></li>
        </ul>
        <span class="muted">Los Angeles · {new Date().getFullYear()}</span>
      </footer>
    </div>
  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  main:focus {
    outline: none;
  }
</style>
