---
import type { CollectionEntry } from "astro:content";
import { formatMonth } from "../lib/notes";

interface Props {
  notes: CollectionEntry<"notes">[];
}

const { notes } = Astro.props;
---

{
  notes.length === 0 ? (
    <p class="empty">First notes are on the way.</p>
  ) : (
    <ul class="note-list">
      {notes.map((note) => (
        <li>
          <div class="note-main">
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            <p>{note.data.description}</p>
          </div>
          <p class="note-meta">
            <time datetime={note.data.date.toISOString().slice(0, 10)}>{formatMonth(note.data.date)}</time>
            <br />
            {note.data.tag}
            {note.data.draft && " · Draft"}
          </p>
        </li>
      ))}
    </ul>
  )
}
