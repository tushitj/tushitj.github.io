---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { getNotes, formatMonth } from "../../lib/notes";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, description, date, tag, cover, coverAlt } = note.data;
---

<Base title={title} description={description} ogType="article">
  <article class="article">
    <header class="article-head">
      <a class="back-link mono" href="/notes/">← All notes</a>
      <h1>{title}</h1>
      <p class="note-meta">
        <time datetime={date.toISOString().slice(0, 10)}>{formatMonth(date)}</time> · {tag}
      </p>
    </header>
    {
      cover && (
        <Image src={cover} alt={coverAlt ?? ""} widths={[640, 960, 1280, 1920]} sizes="(min-width: 78rem) 75rem, 100vw" layout="full-width" loading="eager" fetchpriority="high" />
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
